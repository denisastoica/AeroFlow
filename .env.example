# JWT secret key – schimbă cu o valoare unică în producție
SECRET_KEY=change-me-to-a-random-secret

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Codul de confirmare al comenzii este trimis pe email la plasarea comenzii.
# Pentru Gmail: activează "App Passwords" și pune parola de aplicație la SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Drone Delivery <your-email@gmail.com>
# ────────────────────────────────────────────────────────────────────────────

# Weather API: Meteoromania (ANM) — nu necesită cheie API
# Endpoint public: https://www.meteoromania.ro/wp-json/meteoapi/v2/starea-vremii
